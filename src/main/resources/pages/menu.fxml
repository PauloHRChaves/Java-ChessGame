<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<VBox alignment="CENTER" spacing="20.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pchess.controller.MenuController" styleClass="background">
      
    <children>
        <Label text="Bem-vindo ao P-Chess" styleClass="titulo" />
        
        <!-- chama o metodo onStartGameClicked no MenuController -->
        <Button text="Jogar Partida" onAction="#onStartGameClicked" styleClass="btn-jogar" />
    </children>
</VBox>