<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox alignment="CENTER" spacing="20.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pchess.controller.Menu" 
      styleClass="background">
      
    <children>
        <Label text="MENU" styleClass="titulo" />

        <Button text="Partida PvP" onAction="#onStartPvPClicked" styleClass="btn-jogar" />
        <Button text="SAIR" onAction="#handleExitApplication" styleClass="btn-sair" />
    </children>
</VBox>